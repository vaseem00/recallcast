# RecallCast environment variables.
# Copy to .env.local and fill in real values there. NEVER commit .env.local (git ignores it).
# Empty values are treated as unset. All provider modes default to "mock",
# so the app runs fully offline with no keys.
#
# Keys you may need:
#   YOUTUBE_API_KEY    free; needed for real playlists (YOUTUBE_PROVIDER=api)
#   ANTHROPIC_API_KEY  optional, paid per use; lets Claude pick the moments (AI_PROVIDER=anthropic)
#   Captions need no key (TRANSCRIPT_PROVIDER=youtubei).
# Every variable is explained in docs/configuration.md.

# ---- App ----
# Public base URL (used for same-origin checks, the canonical link of shared pages, robots.txt
# and the sitemap). Optional locally.
APP_URL=http://localhost:3000
# The shared feed the landing page offers to visitors without an account. Press "Share reels" on
# a playlist page and paste the copied link here (or only its 22-character id), then restart.
# Empty: the landing page shows no sample.
SAMPLE_FEED=
# SQLite file (relative to the project root) or :memory:
DATABASE_PATH=./data/recallcast.db
# Holds only legacy MP3s of the removed AI-voiced episodes (deleted with their playlist).
STORAGE_DIR=./storage
# Reverse proxies in front of the app that append to X-Forwarded-For (0-5). 0 = no proxy:
# rate limits use the TCP peer address and ignore X-Forwarded-For. Set it to exactly the
# number of proxies you run (e.g. 1 for one nginx), never more: XFF is client-controlled.
# Behind a proxy, make sure clients cannot reach the app port directly.
TRUST_PROXY_HOPS=0

# ---- Provider modes (real | mock) ----
# api | mock
YOUTUBE_PROVIDER=mock
# youtubei | mock (youtubei needs no key; it reads captions the way YouTube's own apps do)
TRANSCRIPT_PROVIDER=mock
# anthropic | mock (mock always uses the free heuristic pickers, for the episode and the reels)
AI_PROVIDER=mock

# ---- YouTube Data API v3 (YOUTUBE_PROVIDER=api) ----
YOUTUBE_API_KEY=

# ---- Anthropic (AI_PROVIDER=anthropic): two small calls per video with captions, one for the
# episode (videos longer than 4.5 min) and one for its reels (videos longer than 80 s) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
# 1 | 0 - server-side refusal fallbacks, only on models that support them (not Haiku).
CLAUDE_REFUSAL_FALLBACK=1

# ---- Limits ----
MAX_VIDEOS_PER_PLAYLIST=25
MAX_VIDEO_SECONDS=10800
MAX_PLAYLISTS_PER_USER_PER_DAY=5
# Site-wide caps over any rolling 24 hours (they bound the API bill without email verification):
# new accounts, and new playlists across every user.
MAX_SIGNUPS_PER_DAY=100
MAX_PLAYLISTS_PER_DAY=60
# Most reels cut from one video (1-12). A video gets one per five minutes, up to this number.
REELS_PER_VIDEO_MAX=6
# Public links (shared reels and shared feeds) one account may have at a time.
MAX_SHARES_PER_USER=200

# ---- Background worker ----
# 1 | 0 - set 0 to run the web server without processing jobs
WORKER_ENABLED=1
WORKER_POLL_MS=1000
# Jobs one server runs at the same time (1-8)
WORKER_CONCURRENCY=2
# On SIGTERM/SIGINT: running jobs are released back to the queue at once, then get this long
# (ms, 0-120000) to finish before the process exits. Keep it below the platform's drain time
# (railway.json drainingSeconds = 30).
SHUTDOWN_GRACE_MS=15000

# ---- Deploy (Railway) ----
# The Docker image sets NODE_ENV=production, HOSTNAME=0.0.0.0, DATABASE_PATH=/data/recallcast.db,
# STORAGE_DIR=/data/storage and NEXT_MANUAL_SIG_HANDLE=true. On Railway set APP_URL to the public
# https:// URL and TRUST_PROXY_HOPS=1. See docs/deploy.md.
