# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (real keys live in .env.local - never commit)
.env*
.env*.local
!.env.example

# recallcast runtime data (SQLite DB, backups, legacy audio)
/data/
/storage/
/backups/
*.db
*.db-wal
*.db-shm

# logs and test output
*.log
/test-results/
/playwright-report/

# editors and local tool state
.vscode/
.idea/
Thumbs.db
/.hallmark/
/.iceberg/
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
